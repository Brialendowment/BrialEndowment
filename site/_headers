# Security headers for every page and file (Cloudflare Pages / Netlify format).
# - frame-ancestors / X-Frame-Options: the site cannot be embedded in another
#   site (stops clickjacking, e.g. a fake page overlaying the donate form).
# - nosniff: browsers must trust the declared file type.
# - Referrer-Policy: other sites only see "brialendowment.org", never full URLs.
# - Permissions-Policy: no camera / microphone / location access for any script.
# - base-uri / object-src: a page cannot be re-pointed at another site's files, and no plug-in content can load.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Serve the PWA manifest with its proper type (required now that nosniff is on).
/manifest.webmanifest
  Content-Type: application/manifest+json

# Security contact file (RFC 9116), served as plain text.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Fonts and third-party libraries never change under the same address, so browsers may
# keep them for a year. The site's own scripts are loaded with a version stamp
# (/store.js?v=...), see scripts/stamp-assets.py.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
